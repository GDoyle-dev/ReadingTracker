<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReadingTracker.ViewModels"
             xmlns:models="clr-namespace:ReadingTracker.Models"
             x:Class="ReadingTracker.Views.SearchPage"
             x:DataType="vm:SearchViewModel"
             Title="Search">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="Search by title" Text="{Binding Query}" />
            <Button Grid.Column="1" Text="Search" Command="{Binding SearchCommand}" />
        </Grid>

        <Label Grid.Row="1" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />

        <CollectionView x:Name="ResultsView" Grid.Row="2" ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchDoc">
                    <Border Padding="8" Margin="0,0,0,8" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                            <Grid WidthRequest="64" HeightRequest="96" BackgroundColor="LightGray">
                                <Label Text="No cover" FontSize="11" TextColor="Gray"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding CoverUrl}" Aspect="AspectFill" />
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding DisplayTitle}" FontAttributes="Bold" />
                                <Label Text="{Binding DisplayAuthors}" FontSize="13" />
                                <Label Text="{Binding DisplayYear}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           VerticalOptions="Start" HorizontalOptions="Center" />
    </Grid>



</ContentPage>
